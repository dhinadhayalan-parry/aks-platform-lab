# Copy to lab.auto.tfvars for local runs (git-ignored). CI sets the same values
# through TF_VAR_* from GitHub repository variables.
subscription_id              = "00000000-0000-0000-0000-000000000000"
workload_resource_group_name = "rg-plat-lab-platform"

api_server_authorized_ip_ranges = ["203.0.113.10/32"]
gitops_repo_url                 = "https://github.com/<owner>/aks-platform-lab"
gitops_branch                   = "main"

# Everything below has sensible defaults; shown for the drills.
# sku_tier           = "Standard"   # soak week only (~EUR 0.09/h)
# kubernetes_version = "1.34"       # pin a minor before the upgrade drill
# apps_node_count    = 0            # drill 5: free quota for a system-pool surge
# secrets_version    = 2            # drill 7: rotate generated secrets

# slack_webhook_url is ephemeral: export TF_VAR_slack_webhook_url instead.
